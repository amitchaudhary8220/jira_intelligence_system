# Production settings for the Oracle VM deployment.
#   cp .env.production.example .env.production   -> fill it in   -> make deploy HOST=ubuntu@<vm ip>
# The deploy script copies this file to the server as .env (over SSH). It is git-ignored: never commit it.

# ---------------------------------------------------------------- Jira (use a read-only SERVICE ACCOUNT token)
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=

# ---------------------------------------------------------------- LLM (Inception)
INCEPTION_API_KEY=
INCEPTION_MODEL=mercury-2.5

# ---------------------------------------------------------------- app
APP_ENV=production
LOG_LEVEL=INFO
# ---------------------------------------------------------------- login: pick ONE of the two blocks

# (A) "Sign in with Google" on the VM - free, works with a subdomain of your company domain (Google Workspace).
#     Needs: a DNS record PUBLIC_HOST -> the VM's public IP (type A), and a Google OAuth client.
AUTH_MODE=proxy
PUBLIC_HOST=pulse.example.com
# Google Cloud Console > APIs & Services > Credentials > Create credentials > OAuth client ID > Web application
#   Authorized redirect URI: https://<PUBLIC_HOST>/oauth2/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# random 32 bytes, base64: python3 -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
OAUTH2_COOKIE_SECRET=
LOGOUT_URL=/oauth2/sign_out
# Only these email domains get in (checked by oauth2-proxy AND again by the app). Required.
ALLOWED_EMAIL_DOMAINS=example.com

# (B) Cloudflare Tunnel + Access - needs a domain on Cloudflare. Use instead of (A):
# AUTH_MODE=cloudflare
# Cloudflare Zero Trust > Settings > Custom pages: your team domain, e.g. yourteam.cloudflareaccess.com
# CF_ACCESS_TEAM_DOMAIN=
# Zero Trust > Access > Applications > Jira Pulse > Overview: "Application Audience (AUD) Tag"
# CF_ACCESS_AUD=
# Zero Trust > Networks > Tunnels > your tunnel > the token from the install command (the long string after --token)
# CLOUDFLARE_TUNNEL_TOKEN=

# Chat history: last 5 chats per person (least recently used goes), deleted after 90 days untouched
HISTORY_RETENTION_DAYS=90

# Ask Jira limits PER PERSON (a heavy day is ~40-80 questions). Team-wide cap: CHAT_GLOBAL_PER_DAY (0 = none).
CHAT_PER_MINUTE=10
CHAT_PER_DAY=150
CHAT_GLOBAL_PER_DAY=0
