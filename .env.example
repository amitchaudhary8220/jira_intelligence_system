# Copy to .env and fill in. .env is git-ignored - never commit it.

# --- Jira -------------------------------------------------------------
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=you@example.com
# Create at https://id.atlassian.com/manage-profile/security/api-tokens ("Create API token", classic)
JIRA_API_TOKEN=

# --- LLM (Inception Labs, OpenAI-compatible) ----------------------------
INCEPTION_API_KEY=
INCEPTION_MODEL=mercury-2.5

# --- What counts as "working" (comma-separated Jira status names) --------
# A person with an issue in one of these statuses in an open sprint is BUSY.
ACTIVE_STATUSES=In Progress,In Review,Ready to merge,In QA

# --- Worklog convention: "[Category] what was done" (comma-separated categories) ---
# WORKLOG_TAGS=Dev,Testing,Discussion,Code Review,Bug Verification,Design,Automation,DevOps,Debug,Review,Research,Test Setup

# ===================================================================== Production
# APP_ENV=production refuses to start unless login is configured safely.
APP_ENV=development

# Login: none (laptop only) | proxy (company SSO gateway - recommended) | password (shared password - pilot)
AUTH_MODE=none
# proxy mode: the header your SSO gateway puts the signed-in email in
#   oauth2-proxy / most gateways: X-Forwarded-Email   Cloudflare Access: Cf-Access-Authenticated-User-Email
#   Google IAP: X-Goog-Authenticated-User-Email
AUTH_HEADER=X-Forwarded-Email
# Only these email domains get in (comma-separated). Required for proxy mode.
ALLOWED_EMAIL_DOMAINS=
# password mode: shared password (12+ chars) and a secret that signs the login cookie (32+ chars).
#   generate one:  python3 -c "import secrets; print(secrets.token_hex(32))"
APP_PASSWORD=
SECRET_KEY=
SESSION_HOURS=12

# Limits (per signed-in user, or per IP without login). Every chat message costs LLM tokens.
# defaults: production 15 / 300 / 240, development 120 / 5000 / 6000 (so test suites can run)
# CHAT_PER_MINUTE=15
# CHAT_PER_DAY=300
# API_PER_MINUTE=240
LOG_LEVEL=INFO

# Chat history: one SQLite file. Each person keeps their last 5 chats (asking in a 6th removes the one used least
# recently); chats nobody opened for HISTORY_RETENTION_DAYS are deleted. Chats can contain Jira details.
# HISTORY_DB=data/chats.sqlite3
# HISTORY_RETENTION_DAYS=90
